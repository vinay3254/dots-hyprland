{
    "label" : "lock",
    "action" : "hyprlock || loginctl lock-session",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Sleep",
    "keybind" : "u"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch exit",
    "text" : "Log Out",
    "keybind" : "e"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Restart",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shut Down",
    "keybind" : "s"
}
