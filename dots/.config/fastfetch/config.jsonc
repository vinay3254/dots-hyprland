{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "color": {
      "1": "blue",
      "2": "cyan"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "cyan"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "󱂬 Compositor",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "󰞷 Terminal",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "cyan"
    },
    {
      "type": "theme",
      "key": "󰉼 Theme",
      "keyColor": "blue"
    },
    {
      "type": "icons",
      "key": "󰀻 Icons",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
