configuration {
    modi: "drun,run";
    font: "Inter 13";
    show-icons: true;
    display-drun: "󰄛";
}

@theme "/dev/null"

* {
    bg-glass: rgba(30, 30, 30, 0.85);
    bg-selected: rgba(0, 122, 255, 0.95);
    text-main: #f5f5f7;
    text-selected: #ffffff;
    text-dim: #a1a1a6;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: transparent;
    text-color: @text-main;
}

window {
    location: center;
    width: 600px;
    border-radius: 16px;
    border: 1px solid;
    border-color: @border-color;
    background-color: @bg-glass;
    padding: 14px;
}

mainbox { children: [ "inputbar", "listview" ]; spacing: 10px; }

inputbar {
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 10px 14px;
    children: [ "prompt", "entry" ];
    spacing: 10px;
}

prompt { text-color: #007aff; font: "Inter Bold 14"; }
entry { text-color: @text-main; placeholder: "Spotlight Search"; placeholder-color: @text-dim; }

listview { lines: 6; columns: 1; spacing: 4px; }
element { padding: 8px 12px; border-radius: 8px; cursor: pointer; }
element selected.normal { background-color: @bg-selected; text-color: @text-selected; }
element-icon { size: 24px; margin: 0 10px 0 0; }
element-text { text-color: inherit; vertical-align: 0.5; }
